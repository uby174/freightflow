# ── AI assistant ──────────────────────────────────────────────────────────
# Two ways to provide the Anthropic key (either works):
#   1. Set it here (recommended for production) — takes priority.
#   2. Paste it in the admin panel (/admin) — stored server-side in .secrets.json.
# Without a key, the assistant runs in local mode; prices stay exact & deterministic.
ANTHROPIC_API_KEY=

# Optional: require this token to change the key from the admin panel.
# Leave empty for local dev (no gate). Set a strong value before deploying /admin.
SN_ADMIN_TOKEN=

# Demo mode: mock carrier plays a full shipment timeline in minutes instead of weeks
SN_DEMO_SPEED=fast

# Terminal (Bischwiller) — used for pickup distance pricing
SN_WAREHOUSE_LAT=48.7667
SN_WAREHOUSE_LNG=7.8583
SN_WAREHOUSE_ADDRESS="Terminal SN Groupage, 67240 Bischwiller, France"
